# =============================================================================
# Dockerfile.signaling — Signaling server container
# =============================================================================
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential gcc g++ make cmake pkg-config \
        libssl-dev libhiredis-dev libjson-c-dev libcurl4-openssl-dev \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY src/ ./src/
COPY include/ ./include/
COPY Makefile CMakeLists.txt ./

RUN if [ -f CMakeLists.txt ]; then \
        mkdir -p cmake-build && cd cmake-build && \
        cmake .. -DCMAKE_BUILD_TYPE=Release -DTARGET=signaling \
                 -DCMAKE_C_FLAGS="-O2 -Wall -Wextra" && \
        make -j"$(nproc)" signaling_server; \
    elif [ -f Makefile ]; then \
        make -j"$(nproc)" signaling_server; \
    fi

# ---------- Runtime ----------
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        libssl3 libhiredis0.14 libjson-c5 libcurl4 \
        ca-certificates curl tini \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r robocontrol && \
    useradd -r -g robocontrol -d /opt/robocontrol -s /sbin/nologin robocontrol

WORKDIR /opt/robocontrol
RUN mkdir -p bin conf logs certs && chown -R robocontrol:robocontrol /opt/robocontrol

COPY --from=builder /build/cmake-build/signaling_server ./bin/signaling_server
COPY --from=builder /build/output/bin/signaling_server ./bin/signaling_server 2>/dev/null || true

EXPOSE 9600 9601 9602

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -sf http://localhost:9601/health || exit 1

USER robocontrol
ENTRYPOINT ["tini", "--"]
CMD ["./bin/signaling_server", "--config", "/opt/robocontrol/conf/signaling.conf"]
